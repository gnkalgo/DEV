{
  "name": "GnKAlgo",
  "install": "chmod +x scripts/cloud-agent-install.sh && scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "npm run dev --prefix frontend"
    }
  ]
}
