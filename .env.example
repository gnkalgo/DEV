# Copy to .env and replace secrets.

APP_NAME=GnKAlgo
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-64-char-random-string-in-production
ENCRYPTION_KEY=change-me-32-byte-base64-key-for-broker-tokens

DATABASE_URL=sqlite+aiosqlite:///./gnkalgo.db
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,https://www.gnkalgo.com

# Email / SMTP (required to receive verification mail)
# Namecheap Private Email: mail.privateemail.com port 465 (SSL)
# Put the real mailbox password only in local .env — never commit it.

SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_STARTTLS=false
SMTP_SSL=true
SMTP_USER=noreply@gnkalgo.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM=noreply@gnkalgo.com
EMAIL_VERIFICATION_REQUIRED=false
COOKIE_SECURE=false
DHAN_STATIC_IP=

ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=
RATE_LIMIT_ENABLED=true

DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_FEED_WS_URL=wss://api-feed.dhan.co

# Provider roles: Dhan=execution only; FYERS=live backup;
# Upstox V3=historical; Yahoo/RapidAPI=fallback/reference data.
MARKET_DATA_PRIMARY=fyers
MARKET_DATA_FALLBACKS=yahoo,rapidapi
HISTORICAL_DATA_PROVIDER=upstox_v3
FYERS_API_BASE_URL=https://api-t1.fyers.in
FYERS_DATA_WS_URL=wss://api.fyers.in/socket/v2/data/
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
# RapidAPI subscription values (never commit the real key).
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_QUOTES_URL=
MARKET_DATA_LAKE_PATH=/data/market

# Instrument master (Dhan compact CSV)
INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv
INSTRUMENT_SYNC_ENABLED=true
INSTRUMENT_SYNC_INTERVAL_HOURS=24

# Redis cache TTLs (seconds)
CACHE_CANDLES_TTL_SECONDS=120
CACHE_NEWS_TTL_SECONDS=300

# News (Finnhub — optional; mock_dev when unset in development)
NEWS_PROVIDER=finnhub
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

GROWW_API_BASE_URL=https://api.groww.in

# Comma-separated emails that get /admin after login
ADMIN_EMAILS=you@gnkalgo.com

# UPI only (PhonePe / GPay / Paytm). Put your real VPA.
UPI_VPA=yourname@oksbi
UPI_PAYEE_NAME=GNK ALGO
SUPPORT_EMAIL=support@gnkalgo.com

# Auto-renew: email UPI link N hours before plan expires
AUTO_RENEW_LEAD_HOURS=24
BILLING_SCHEDULER_TICK_SECONDS=3600
